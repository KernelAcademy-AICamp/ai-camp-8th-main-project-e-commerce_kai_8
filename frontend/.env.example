# frontend 환경변수 (팀 공유용 템플릿)
# 사용법: cp .env.example .env.local  후 실제 값 채우기. .env.local 은 커밋되지 않음.

# ── Supabase (읽기 전용 노출 — 브라우저에 공개돼도 되는 키만) ─────────
# 값은 ecommerce/client/.env.local 과 동일 (같은 Supabase 프로젝트 공용).
# publishable(anon) 키는 공개 전제 키다. RLS로 c_feed_products 뷰·c_feed_page RPC만 읽을 수 있다.
# ⚠️ sb_secret_... (서버 전용 키)는 절대 여기에 넣지 않는다.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
