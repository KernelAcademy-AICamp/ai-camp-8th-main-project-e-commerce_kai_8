{
  "meta": {
    "purpose": "컬러웨이 결속 검색(결정적 파서, LLM 의미 해석 없음) 해석 골든셋 — 쿼리 원문 → ①기대 해석 ②기대 결속 계획의 2층 기대값.",
    "createdAt": "2026-08-07",
    "plan": "docs/superpowers/plans/2026-08-07-colorway-print-search-baseline.md",
    "decisions": "docs/design/2026-08-07-colorway-search-kickoff-decisions.md",
    "scope": {
      "included": "정확 캐논 표현 + 검증된 고정 alias만. 의미 표현(시커먼·푸르딩딩한 등)은 미해결이 정답.",
      "excluded": "LLM 의미 해석(2차 출하선), 프린팅 없음(무지) 강한 조건(설계 §14.1 보류), 0건 완화(설계 §14.4 미결)"
    },
    "layers": {
      "interpretation": "conditions: 대상별 조건(target: base|print|placement|graphic, values, polarity, evidence=원문 부분문자열) / external: 외부 맥락으로 분리된 표현(조건 금지) / unresolved: 해석하지 못해 조건을 만들면 안 되는 표현",
      "plan": "productBaseColors: 상품 수준 옷 색 검색(무지 포함, 결속 불필요) / printClauses: 같은 프린트 객체 안에서 함께 성립해야 하는 조건 묶음(배열 1개 = 객체 1개 요구) / mustNotBaseColors: 명시적 부정 / printExists: 속성 없이 프린팅 존재만 요구"
    },
    "conventions": [
      "결정적 경로만 다루므로 모든 성립 조건의 강제 수준은 must다(필드별 표기 생략).",
      "alias 근거는 색 표현 골든셋 50건의 direct·high 항목만 사용(검정→블랙, 흰색/하얀→화이트, 빨간→레드, 회색→그레이 등).",
      "external의 표현은 어떤 상품 조건으로도 컴파일되면 안 된다.",
      "unresolved의 표현은 하드필터를 만들면 안 되고, 소비되지 않은 표현은 기존 검색 경로(제목 등)가 그대로 처리한다."
    ],
    "buckets": {
      "binding": "바탕색×프린트 속성 결속(같은 객체)",
      "baseOnly": "바탕색 단독(상품 수준, 무지 포함)",
      "placementOnly": "위치 단독",
      "multiObject": "서로 다른 객체 복수 요구",
      "negation": "명시적 부정(보수 규칙)",
      "external": "외부 맥락 분리",
      "unresolvedOnly": "의미 표현·사전 밖 표현의 미해결 처리"
    },
    "acceptanceCriteria": "binding·negation 버킷 전건 통과. 나머지 버킷은 실패 시 원인 분류 후 협의.",
    "labeling": {
      "process": "검색 담당 초안 → 검토 → 동결",
      "frozen": true,
      "frozenAt": "2026-08-07",
      "reviewNote": "판단이 갈리는 5건(cw007·cw018·cw019·cw023·cw027) 포함 검토 승인 후 동결. 이후 변경은 meta.changes에 사유 기록. 구현에 맞춰 기대값을 수정하지 않는다."
    }
  },
