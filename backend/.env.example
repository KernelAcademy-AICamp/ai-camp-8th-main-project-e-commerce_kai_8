# backend 환경변수 (팀 공유용 템플릿)
# 사용법: cp .env.example .env.local  후 실제 값 채우기. .env.local 은 커밋되지 않음.

# ── Supabase (ecommerce와 같은 프로젝트를 공용) ─────────────────────
# 값은 ecommerce/backend/.env.local 과 동일. c_goods(226,320행)는 이미 적재돼 있다.
# 대시보드 → Project Settings → API Keys → "Secret keys"에서 sb_secret_... 복사.
# ⚠️ secret 키는 서버 전용(전체 권한). 절대 클라이언트/브라우저/커밋에 노출 금지.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ── DB 직접 접속 문자열 (마이그레이션·적재·백업용) ────────────────────
# 대시보드 → Connect → psql 의 connection string(세션 풀러 권장).
# ⚠️ 비번 포함 — 절대 커밋 금지(.env.local 은 git 무시됨).
SUPABASE_DB_URL=postgresql://postgres.your-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# ── 로컬 원본 Postgres (재수집·파생 테이블 재생성 시에만) ─────────────
# c_raw_goods(842MB) 원본은 로컬 c_verify DB(포트 55432)에만 있다.
# C_TEST_DSN 을 설정하면 test_c_upsert 통합 테스트가 실행된다.
# ⚠️ 테스트는 truncate를 하므로 '_test'로 끝나는 DB만 허용된다(c_verify 금지).
# C_TEST_DSN=postgresql://postgres@127.0.0.1:55432/c_test
